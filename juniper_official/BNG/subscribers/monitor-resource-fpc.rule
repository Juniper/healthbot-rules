healthbot {
    topic bng.subscribers {
        rule monitor-resource-fpc {
            keys [ "fpc-slot" ];
            synopsis "Monitors subscriber-management resource utilization (fpc scope)";
            description "Monitors per-FPC subscriber-management resources on BNG";
            add-site-id true;
            sensor resource-monitor-information {
                description "Monitors subscriber-management resource utilization";
                synopsis "Monitors subscriber-management resource utilization";
                open-config {
                    frequency "60s";
                    sensor-name "/junos/system/subscriber-management/infra/resource-monitor";
                }
            }
            field fpc-slot {
                description "FPC slot number";
                sensor resource-monitor-information {
                    path "/junos/system/subscriber-management/infra/resource-monitor/fpcs/fpc/@slot";
                }
                type "string";
            }
            field fpc-client-session-denied-count {
                description "FPC client sessions denied";
                sensor resource-monitor-information {
                    path "/junos/system/subscriber-management/infra/resource-monitor/fpcs/fpc/statistics/client-session-denied-count";
                }
                type "integer";
                plots FPC client sessions denied {
                    unit "events";
                    triggers "fpc-client-session-denied";
                }
            }
            field fpc-current-subscriber-count {
                description "FPC current subscriber count";
                sensor resource-monitor-information {
                    path "/junos/system/subscriber-management/infra/resource-monitor/fpcs/fpc/statistics/current-subscriber-count";
                }
                type "integer";
                plots FPC current subscriber count {
                    unit "subscribers";
                }
            }
            field fpc-configured-subscriber-limit {
                description "FPC configured subscriber limit (absolute count; streams only when a limit is configured)";
                sensor resource-monitor-information {
                    path "/junos/system/subscriber-management/infra/resource-monitor/fpcs/fpc/statistics/configured-subscriber-limit";
                }
                type "integer";
                plots FPC configured subscriber limit {
                    unit "subscribers";
                }
            }
            field fpc-subscriber-limit-utilization {
                description "Percent of the configured FPC subscriber limit in use";
                formula {
                    eval {
                        expression "( $fpc-current-subscriber-count / $fpc-configured-subscriber-limit ) * 100";
                    }
                }
                type "float";
                plots FPC subscriber limit utilization {
                    unit "percent";
                    triggers "fpc-subscriber-limit-utilization";
                }
            }
            field subscriber-limit-utilization-warning-threshold {
                constant {
                    value "{{subscriber-limit-utilization-warning-threshold}}";
                }
                description "Warning threshold: percent of the configured limit (default 75)";
                type "integer";
            }
            field subscriber-limit-utilization-critical-threshold {
                constant {
                    value "{{subscriber-limit-utilization-critical-threshold}}";
                }
                description "Critical threshold: percent of the configured limit (default 100 = at the limit)";
                type "integer";
            }
            field fpc-heap-memory-used {
                description "FPC heap memory used, percent (verified: smid exports percent_used)";
                sensor resource-monitor-information {
                    path "/junos/system/subscriber-management/infra/resource-monitor/fpcs/fpc/statistics/heap-memory-used";
                }
                type "integer";
                plots FPC heap memory used {
                    unit "percent";
                    triggers "fpc-heap-memory-utilization";
                }
            }
            field fpc-heap-memory-critical-threshold {
                constant {
                    value "{{fpc-heap-memory-critical-threshold}}";
                }
                description "FPC heap memory high threshold, percent. Default 70 (JUNOS default). RD backend: wire to [system services resource-monitor high-threshold].";
                type "integer";
            }
            variable subscriber-limit-utilization-warning-threshold {
                description "Warning threshold: percent of the configured limit (default 75)";
                type "integer";
                value "75";
            }
            variable subscriber-limit-utilization-critical-threshold {
                description "Critical threshold: percent of the configured limit (default 100 = at the limit)";
                type "integer";
                value "100";
            }
            variable fpc-heap-memory-critical-threshold {
                description "FPC heap memory high threshold, percent. Default 70 (JUNOS default). RD backend: wire to [system services resource-monitor high-threshold].";
                type "integer";
                value "70";
            }
            trigger fpc-subscriber-limit-utilization {
                alert-type "bng.subscriber-resource-utilization.fpc.subscriber-limit";
                description "Alert on FPC subscriber-limit utilization: warning at 75% of the limit, critical at the limit";
                synopsis "Alert on FPC subscriber-limit utilization versus the configured limit";
                term is-no-limit {
                    when {
                        less-than-or-equal-to "$fpc-configured-subscriber-limit" "0";
                    }
                    then {
                        status {
                            color "green";
                            message "No FPC subscriber limit is configured; utilization not evaluated.";
                        }
                    }
                }
                term is-healthy {
                    when {
                        less-than "$fpc-subscriber-limit-utilization" "$subscriber-limit-utilization-warning-threshold";
                    }
                    then {
                        status {
                            color "green";
                            message "fpc-subscriber-limit-utilization = $fpc-subscriber-limit-utilization%, below the warning level.";
                        }
                    }
                }
                term is-warning {
                    when {
                        less-than "$fpc-subscriber-limit-utilization" "$subscriber-limit-utilization-critical-threshold";
                    }
                    then {
                        status {
                            color "yellow";
                            message "FPC $fpc-slot: fpc-subscriber-limit-utilization = $fpc-subscriber-limit-utilization%, above $subscriber-limit-utilization-warning-threshold% of the configured limit.";
                        }
                    }
                }
                term is-critical {
                    when {
                        greater-than-or-equal-to "$fpc-subscriber-limit-utilization" "$subscriber-limit-utilization-critical-threshold";
                    }
                    then {
                        status {
                            color "red";
                            message "FPC $fpc-slot: fpc-subscriber-limit-utilization = $fpc-subscriber-limit-utilization% - the configured limit is reached.";
                        }
                    }
                }
            }
            trigger fpc-client-session-denied {
                alert-type "bng.subscriber-resource-utilization.fpc.client-session-denied";
                description "Alert when the fpc-client-session-denied-count counter increases (new denied sessions since the previous poll)";
                synopsis "Alert on any fpc-client-session-denied-count breach";
                term is-healthy {
                    when {
                        matches-with-previous "$fpc-client-session-denied-count";
                    }
                    then {
                        status {
                            color "green";
                            message "fpc-client-session-denied-count count is normal, no new denied sessions since the previous poll.";
                        }
                    }
                }
                term is-critical {
                    when {
                        exists "$fpc-client-session-denied-count";
                    }
                    then {
                        status {
                            color "red";
                            message "FPC $fpc-slot: fpc-client-session-denied-count = $fpc-client-session-denied-count, new client session(s) denied since the previous poll.";
                        }
                    }
                }
            }
            trigger fpc-heap-memory-utilization {
                alert-type "bng.subscriber-resource-utilization.fpc.heap-memory";
                description "Alert when FPC heap memory reaches the configured threshold (single tier, direct percent compare)";
                synopsis "Alert when FPC heap memory reaches the configured threshold";
                term is-healthy {
                    when {
                        less-than "$fpc-heap-memory-used" "$fpc-heap-memory-critical-threshold";
                    }
                    then {
                        status {
                            color "green";
                            message "fpc-heap-memory-used = $fpc-heap-memory-used%, below the threshold $fpc-heap-memory-critical-threshold%.";
                        }
                    }
                }
                term is-critical {
                    when {
                        greater-than-or-equal-to "$fpc-heap-memory-used" "$fpc-heap-memory-critical-threshold";
                    }
                    then {
                        status {
                            color "red";
                            message "FPC $fpc-slot: fpc-heap-memory-used = $fpc-heap-memory-used% - the configured threshold $fpc-heap-memory-critical-threshold% is reached.";
                        }
                    }
                }
            }
            rule-properties {
                supported-devices {
                    juniper {
                        operating-system junos {
                            products MX {
                                platforms MX10K {
                                    releases 19.1R1 {
                                        release-support "min-supported-release";
                                    }
                                }
                                platforms MX2010 {
                                    releases 19.1R1 {
                                        release-support "min-supported-release";
                                    }
                                }
                                platforms MX2020 {
                                    releases 19.1R1 {
                                        release-support "min-supported-release";
                                    }
                                }
                                platforms MX204 {
                                    releases 19.1R1 {
                                        release-support "min-supported-release";
                                    }
                                }
                                platforms MX240 {
                                    releases 19.1R1 {
                                        release-support "min-supported-release";
                                    }
                                }
                                platforms MX480 {
                                    releases 19.1R1 {
                                        release-support "min-supported-release";
                                    }
                                }
                                platforms MX960 {
                                    releases 19.1R1 {
                                        release-support "min-supported-release";
                                    }
                                }
                                platforms VMX {
                                    releases 19.1R1 {
                                        release-support "min-supported-release";
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
