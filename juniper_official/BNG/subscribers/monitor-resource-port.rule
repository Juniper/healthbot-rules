healthbot {
    topic bng.subscribers {
        rule monitor-resource-port {
            keys [ "fpc-slot" "pic-number" "port-number" ];
            synopsis "Monitors subscriber-management resource utilization (port scope)";
            description "Monitors per-port subscriber-limit utilization on BNG, comparing active subscribers against the configured port limit";
            sensor resource-monitor-information {
                description "Monitors subscriber-management resource utilization";
                synopsis "Monitors subscriber-management resource utilization";
                open-config {
                    frequency "60s";
                    sensor-name "/junos/system/subscriber-management/infra/resource-monitor";
                }
            }
            field fpc-slot {
                description "FPC slot number";
                sensor resource-monitor-information {
                    path "/junos/system/subscriber-management/infra/resource-monitor/fpcs/fpc/@slot";
                }
                type "string";
            }
            field pic-number {
                description "PIC number within the FPC";
                sensor resource-monitor-information {
                    path "/junos/system/subscriber-management/infra/resource-monitor/fpcs/fpc/pics/pic/@pic-no";
                }
                type "string";
            }
            field port-number {
                description "Port number within the PIC";
                sensor resource-monitor-information {
                    path "/junos/system/subscriber-management/infra/resource-monitor/fpcs/fpc/pics/pic/ports/port/@port-no";
                }
                type "string";
            }
            field port-current-subscriber-count {
                description "Port current subscriber count";
                sensor resource-monitor-information {
                    path "/junos/system/subscriber-management/infra/resource-monitor/fpcs/fpc/pics/pic/ports/port/current-subscriber-count";
                }
                type "integer";
                plots Port current subscriber count {
                    unit "subscribers";
                }
            }
            field port-configured-subscriber-limit {
                description "Port configured subscriber limit (absolute count; streams only when a limit is configured)";
                sensor resource-monitor-information {
                    path "/junos/system/subscriber-management/infra/resource-monitor/fpcs/fpc/pics/pic/ports/port/configured-subscriber-limit";
                }
                type "integer";
                plots Port configured subscriber limit {
                    unit "subscribers";
                }
            }
            field port-subscriber-limit-utilization {
                description "Percent of the configured Port subscriber limit in use";
                formula {
                    eval {
                        expression "( $port-current-subscriber-count / $port-configured-subscriber-limit ) * 100";
                    }
                }
                type "float";
                plots Port subscriber limit utilization {
                    unit "percent";
                    triggers "port-subscriber-limit-utilization";
                }
            }
            field subscriber-limit-utilization-warning-threshold {
                constant {
                    value "{{subscriber-limit-utilization-warning-threshold}}";
                }
                description "Warning threshold: percent of the configured limit (default 75)";
                type "integer";
            }
            field subscriber-limit-utilization-critical-threshold {
                constant {
                    value "{{subscriber-limit-utilization-critical-threshold}}";
                }
                description "Critical threshold: percent of the configured limit (default 100 = at the limit)";
                type "integer";
            }
            variable subscriber-limit-utilization-warning-threshold {
                description "Warning threshold: percent of the configured limit (default 75)";
                type "integer";
                value "75";
            }
            variable subscriber-limit-utilization-critical-threshold {
                description "Critical threshold: percent of the configured limit (default 100 = at the limit)";
                type "integer";
                value "100";
            }
            trigger port-subscriber-limit-utilization {
                description "Alert on Port subscriber-limit utilization: warning at 75% of the limit, critical at the limit";
                synopsis "Alert on Port subscriber-limit utilization versus the configured limit";
                term is-no-limit {
                    when {
                        less-than-or-equal-to "$port-configured-subscriber-limit" "0";
                    }
                    then {
                        status {
                            color "green";
                            message "No Port subscriber limit is configured; utilization not evaluated.";
                        }
                    }
                }
                term is-healthy {
                    when {
                        less-than "$port-subscriber-limit-utilization" "$subscriber-limit-utilization-warning-threshold";
                    }
                    then {
                        status {
                            color "green";
                            message "port-subscriber-limit-utilization is healthy.";
                        }
                    }
                }
                term is-warning {
                    when {
                        less-than "$port-subscriber-limit-utilization" "$subscriber-limit-utilization-critical-threshold";
                    }
                    then {
                        status {
                            color "yellow";
                            message "FPC $fpc-slot PIC $pic-number Port $port-number: port-subscriber-limit-utilization = $port-subscriber-limit-utilization%, above $subscriber-limit-utilization-warning-threshold% of the configured limit.";
                        }
                    }
                }
                term is-critical {
                    when {
                        greater-than-or-equal-to "$port-subscriber-limit-utilization" "$subscriber-limit-utilization-critical-threshold";
                    }
                    then {
                        status {
                            color "red";
                            message "FPC $fpc-slot PIC $pic-number Port $port-number: port-subscriber-limit-utilization = $port-subscriber-limit-utilization% - the configured limit is reached.";
                        }
                    }
                }
            }
            rule-properties {
                supported-devices {
                    juniper {
                        operating-system junos {
                            products MX {
                                platforms MX10K {
                                    releases 19.1R1 {
                                        release-support "min-supported-release";
                                    }
                                }
                                platforms MX2010 {
                                    releases 19.1R1 {
                                        release-support "min-supported-release";
                                    }
                                }
                                platforms MX2020 {
                                    releases 19.1R1 {
                                        release-support "min-supported-release";
                                    }
                                }
                                platforms MX204 {
                                    releases 19.1R1 {
                                        release-support "min-supported-release";
                                    }
                                }
                                platforms MX240 {
                                    releases 19.1R1 {
                                        release-support "min-supported-release";
                                    }
                                }
                                platforms MX480 {
                                    releases 19.1R1 {
                                        release-support "min-supported-release";
                                    }
                                }
                                platforms MX960 {
                                    releases 19.1R1 {
                                        release-support "min-supported-release";
                                    }
                                }
                                platforms VMX {
                                    releases 19.1R1 {
                                        release-support "min-supported-release";
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
