/*
	* Rule to collect CM Error Configuration.
*/
healthbot {
	topic hardware.fpc {
		rule cm-errors-configuration {
			keys [ fru-slot fru-type identifier ];
			synopsis "CM Error Configuration";
			description "CM Error Configuration";
			sensor sensor-cm-errors-config {
				synopsis "CM Error Configuration";
				description "CM Error Configuration";
				open-config {
					sensor-name /junos/system/cmerror/configuration/;
					frequency 60s;
				}
			}
			field fru-slot {
				sensor sensor-cm-errors-config {
					path "/junos/system/cmerror/configuration/fru-slot";
				}
				type string;
				description "FRU Slot";
			}
			field fru-type {
				sensor sensor-cm-errors-config {
					path "/junos/system/cmerror/configuration/fru-type";
				}
				type string;
				description "FRU Type";
			}
			field identifier {
				sensor sensor-cm-errors-config {
					path "/junos/system/cmerror/configuration/identifier";
				}
				type string;
				description "Error Identifier";
			}
			field name {
				sensor sensor-cm-errors-config {
					path "/junos/system/cmerror/configuration/name";
				}
				type string;
				description "Configuration Name";
			}
			field action {
				sensor sensor-cm-errors-config {
					path "/junos/system/cmerror/configuration/action";
				}
				type integer;
				description "Error Action";
			}
			field severity {
				sensor sensor-cm-errors-config {
					path "/junos/system/cmerror/configuration/severity";
				}
				type string;
				description "Error Severity";
			}

            rule-properties {
                version 1;
                contributor juniper;
                category advanced;
                supported-healthbot-version 4.2.0;
                supported-devices {
                    juniper {
                        operating-system junosEvolved {
                            products PTX {
                                platforms PTX10001-36MR {
                                    releases 22.2R1 {
                                        sensors sensor-cm-errors-config;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms PTX10002-36QDD {
                                    releases 22.2R1 {
                                        sensors sensor-cm-errors-config;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms PTX10003 {
                                    releases 22.2R1 {
                                        sensors sensor-cm-errors-config;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms PTX10004 {
                                    releases 22.2R1 {
                                        sensors sensor-cm-errors-config;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms PTX10008 {
                                    releases 22.2R1 {
                                        sensors sensor-cm-errors-config;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms PTX10016 {
                                    releases 22.2R1 {
                                        sensors sensor-cm-errors-config;
                                        release-support min-supported-release;
                                    }
                                }
                            }
                        }
                        operating-system junos {    
                            products MX {
                                platforms MX204 {
                                    releases 24.4R2 {
                                        sensors sensor-cm-errors-config;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms MX240 {
                                    releases 24.4R2 {
                                        sensors sensor-cm-errors-config;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms MX301 {
                                    releases 24.4R2 {
                                        sensors sensor-cm-errors-config;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms MX304 {
                                    releases 24.4R2 {
                                        sensors sensor-cm-errors-config;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms MX480 {
                                    releases 24.4R2 {
                                        sensors sensor-cm-errors-config;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms MX960 {
                                    releases 24.4R2 {
                                        sensors sensor-cm-errors-config;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms MX10004 {
                                    releases 24.4R2 {
                                        sensors sensor-cm-errors-config;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms MX10008 {
                                    releases 24.4R2 {
                                        sensors sensor-cm-errors-config;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms MX2010 {
                                    releases 24.4R2 {
                                        sensors sensor-cm-errors-config;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms MX2008 {
                                    releases 24.4R2 {
                                        sensors sensor-cm-errors-config;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms MX2020 {
                                    releases 24.4R2 {
                                        sensors sensor-cm-errors-config;
                                        release-support min-supported-release;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
