/*
* Rule to get all the PFE stats(ASIC input/output) stats
* Upstream application will use these stats to find anomaly
*/
healthbot {
    topic hardware.fpc {
        rule pfe-stats {
            keys fpc;
            synopsis "PFE transit traffic stats";
            description "PFE ASIC input/output stats";
            sensor pfestats {
                synopsis "PFE transit traffic stats";
                description "GNMI based telemetry which collects ASIC traffic stats";
                open-config {
                    sensor-name /junos/system/linecard/packet/usage/;
                    frequency 60s;
                }
            }
            field ts-input-packets-pps {
                sensor pfestats {
					where "/components/component/properties/property/@name == 'ts-input-packets-pps'";
                    path /components/component/properties/property/state/value;
                }
                type unsigned-integer;
                description "PFE input stats";
            }
            field ts-output-packets-pps {
                sensor pfestats {
					where "/components/component/properties/property/@name == 'ts-output-packets-pps'";
                    path /components/component/properties/property/state/value;
                }
                type unsigned-integer;
                description "PFE output stats";
            }
            field fpc {
                sensor pfestats {
                    path "/components/component/@name";
                }
                type string;
                description "FPC name";
            }
            rule-properties {
                version 1;
                contributor juniper;
                category basic;
                supported-healthbot-version 1.0.0;
                supported-devices {
                    juniper {
                        operating-system junosEvolved {
                            products PTX {
                                platforms PTX10003 {
                                    releases 22.2R1 {
                                        sensors pfestats;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms PTX10001-36MR {
                                    releases 22.2R1 {
                                        sensors pfestats;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms PTX10002-36QDD {
                                    releases 22.2R1 {
                                        sensors pfestats;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms PTX10004 {
                                    releases 22.2R1 {
                                        sensors pfestats;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms PTX10008 {
                                    releases 22.2R1 {
                                        sensors pfestats;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms PTX10016 {
                                    releases 22.2R1 {
                                        sensors pfestats;
                                        release-support min-supported-release;
                                    }
                                }
                            }
                        }
                        operating-system junos {    
                            products MX {
                                platforms MX480 {
                                    releases 24.4R2 {
                                        sensors pfestats;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms MX960 {
                                    releases 24.4R2 {
                                        sensors pfestats;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms MX304 {
                                    releases 24.4R2 {
                                        sensors pfestats;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms MX204 {
                                    releases 24.4R2 {
                                        sensors pfestats;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms MX80 {
                                    releases 24.4R2 {
                                        sensors pfestats;
                                        release-support min-supported-release;
                                    }
                                }
                                platforms MX104 {
                                    releases 24.4R2 {
                                        sensors pfestats;
                                        release-support min-supported-release;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
