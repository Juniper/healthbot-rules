/*
 * Monitor Coherent optics stats like Carrier Frequency Offset,Optical/Effective Signal to Noise Ratio,
 * pre-fec ber and notify anomalies
 *
 * Req 1105 : https://paragon-automation.atlassian.net/browse/REQ-1105
 * 
 */
healthbot {
    topic interfaces {
        rule check-optical-cfo-osnr-esnr-pre-fec-ber {
        keys interface-name;
        synopsis "KPI for  interface optical degradation";
        description "Monitor the interface optical degradation";
        sensor optical-sensor-oc {
            synopsis "Interface optics sensor definition";
            description "Sensor to collects data from network device";
            open-config {
                sensor-name /components/component;
                frequency 60s;
            }
        }
        field carrier-frequency-offset {
            sensor optical-sensor-oc {
                path /components/component/optical-channel/state/carrier-frequency-offset/instant;
            }
            type float;
            description "Offset (MHz) between the received optical carrier and the receiver's local oscillator. Large values in either direction indicate laser drift";
            plots carrier-frequency-offset {
                triggers carrier-frequency-offset;
                unit Mhz;
                thresholds carrier-frequency-offset-high-threshold {
                    field-name "$carrier-frequency-offset-high-threshold";
                    severity critical;
                }
                thresholds carrier-frequency-offset-low-threshold {
                    field-name "$carrier-frequency-offset-low-threshold";
                    severity critical;
                }
            }
        }
        field carrier-frequency-offset-high-threshold {
            constant {
                value "{{carrier-frequency-offset-high-threshold}}";
            }
            type float;
            description "Upper CFO limit (MHz). CFO at or above this value raises a critical alert";
        }
        field carrier-frequency-offset-low-threshold {
            constant {
                value "{{carrier-frequency-offset-low-threshold}}";
            }
            type float;
            description "Lower (most negative) CFO limit (MHz). CFO at or below this value raises a critical alert";
        }
        field chromatic-dispersion {
            sensor optical-sensor-oc {
                path /components/component/optical-channel/state/chromatic-dispersion/instant;
            }
            type float;
            description "Accumulated chromatic dispersion on the channel, as estimated by the coherent DSP";
            plots chromatic-dispersion {
                unit ps/nm;
            }			
        }
        field esnr {
            sensor optical-sensor-oc {
                path /components/component/optical-channel/state/esnr/instant;
            }
            type float;
            description "Actual signal quality seen by the receiver after all impairments are considered";
            plots esnr {
                triggers esnr;
                unit db;
                thresholds esnr-low-threshold {
                    field-name "$esnr-low-threshold";
                    severity critical;
                }				
            }
        }
        field esnr-low-threshold {
            constant {
                value "{{esnr-low-threshold}}";
            }
            type float;
            description "Default esnr low threshold.";
        }
        field interface-name {
            sensor optical-sensor-oc {
                where "/components/component/@name =~ /{{interface-name}}/";
                path "/components/component/@name";
            }
            type string;
            description "Interface name";
        }
        field rx-signal-power {
            sensor optical-sensor-oc {
                path /components/component/optical-channel/state/input-power/instant;
            }
            type float;
            description "Received optical signal power (dBm) of the channel, as measured by the coherent DSP";
            plots rx-signal-power {
                triggers interface-optical-rx-signal-power;
                unit dbm;
                thresholds rx-signal-power-high-threshold {
                    field-name "$rx-signal-power-high-threshold";
                    severity critical;
                }
                thresholds rx-signal-power-low-threshold {
                    field-name "$rx-signal-power-low-threshold";
                    severity critical;
                }
            }
        }
        field rx-signal-power-high-threshold {
            constant {
                value "{{rx-signal-power-high-threshold}}";
            }
            type float;
            description "Default Rx Signal Power High threshold.";
        }
        field rx-signal-power-low-threshold {
            constant {
                value "{{rx-signal-power-low-threshold}}";
            }
            type float;
            description "Default Rx Signal Power low threshold.";
        }
        field osnr {
            sensor optical-sensor-oc {
                path /components/component/optical-channel/state/osnr/instant;
            }
            type float;
            description "Quality of an optical signal relative to the optical noise present on the fiber";
            plots osnr {
                triggers osnr;
                unit db;
                thresholds osnr-low-threshold {
                    field-name "$osnr-low-threshold";
                    severity critical;
                }				
            }
        }
        field osnr-low-threshold {
            constant {
                value "{{osnr-low-threshold}}";
            }
            type float;
            description "Default osnr low threshold.";
        }
        field polarization-dependent-loss {
            sensor optical-sensor-oc {
                path /components/component/optical-channel/state/polarization-dependent-loss/instant;
            }
            type float;
            description "PDL is the difference between the maximum and minimum transmission loss of an optical component as the input light polarization changes";
            plots polarization-dependent-loss {
                unit db;
            }			
        }
        field pre-fec-ber {
            sensor optical-sensor-oc {
                path /components/component/optical-channel/state/pre-fec-ber/instant;
            }
            type float;
            description "Bit error rate before error correction";
            plots pre-fec-ber {
                triggers pre-fec-ber;
                unit count;
                thresholds pre-fec-ber-high-threshold {
                    field-name "$pre-fec-ber-high-threshold";
                    severity critical;
                }				
            }
        }
        field pre-fec-ber-high-threshold {
            constant {
                value "{{pre-fec-ber-high-threshold}}";
            }
            type float;
            description "Default pre-fec-ber high threshold.";
        }
        field q-factor {
            formula {
                qfactor {
                    ber "$pre-fec-ber";
                }
            }
            type float;
            description "Q-factor is a measure of how well the receiver can distinguish between transmitted symbols in the presence of noise";
            plots q-factor {
                unit db;
                thresholds q-factor-threshold {
                    field-name "$q-factor-threshold";
                    severity critical;
                }				
            }
        }
        field q-factor-threshold {
            constant {
                value "{{q-factor-threshold}}";
            }
            type float;
            description "Threshold below which qfactor is considered unstable or failing";
        }
        field q-margin {
            formula {
                qmargin {
                    ber "$pre-fec-ber";
                    fec-threshold-ber "$fec-threshold-ber";					
                }
            }
            type float;
            description "It tells you how much performance headroom remains before the link reaches its FEC correction limit";
            plots q-margin {
                unit db;
                thresholds q-margin-threshold {
                    field-name "$q-margin-threshold";
                    severity critical;
                }				
            }
        }
        field fec-threshold-ber {
            constant {
                value "{{fec-threshold-ber}}";
            }
            type float;
            description "Threshold to be used in q-margin formula";
        }		
        field q-margin-threshold {
            constant {
                value "{{q-margin-threshold}}";
            }
            type float;
            description "Threshold below which qfactor is considered unstable or failing";
        }
        trigger carrier-frequency-offset {
            synopsis "Interface optical CFO KPI";
            description "Offset (MHz) between the received optical carrier and the receiver's local oscillator. Large values in either direction indicate laser drift";
            alert-type interfaces.optics.signal-quality.carrier-frequency-offset;
            term normal-carrier-frequency-offset {
                when {
                    greater-than "$carrier-frequency-offset" "$carrier-frequency-offset-low-threshold";
                    less-than "$carrier-frequency-offset" "$carrier-frequency-offset-high-threshold";
                }
                then {
                    status {
                        color green;
                        message "$interface-name,CFO $carrier-frequency-offset is normal";
                    }
                }
            }
            term carrier-frequency-offset-above-critical-threshold {
                when {
                    greater-than-or-equal-to "$carrier-frequency-offset" "$carrier-frequency-offset-high-threshold";
                }
                then {
                    status {
                        color red;
                        message "$interface-name,CFO $carrier-frequency-offset is above high warning threshold ($carrier-frequency-offset-high-threshold) ";
                    }
                }
            }
            term carrier-frequency-offset-below-minor-threshold {
                when {
                    less-than-or-equal-to "$carrier-frequency-offset" "$carrier-frequency-offset-low-threshold";
                }
                then {
                    status {
                        color red;
                        message "$interface-name,CFO $carrier-frequency-offset is below low warning threshold ($carrier-frequency-offset-low-threshold) ";
                    }
                }
            }
        }
        trigger esnr {
            synopsis "Effective Signal-to-Noise Ratio";
            description "Actual signal quality seen by the receiver after all impairments are considered";
            alert-type interfaces.optics.signal-quality.esnr;
            term no-esnr {
                when {
                    greater-than-or-equal-to "$esnr" "$esnr-low-threshold";
                }
                then {
                    status {
                        color green;
                        message "$interface-name,esnr $esnr is normal";
                    }
                }
            }
            term esnr-present {
                when {
                    less-than "$esnr" "$esnr-low-threshold";
                }
                then {
                    status {
                        color red;
                        message "$interface-name,esnr $esnr is below low threshold ($esnr-low-threshold) ";
                    }
                }
            }
        }
        trigger interface-optical-rx-signal-power {
            synopsis "Interface optical Rx Signal Power KPI";
            description "Rx Signal Power of the optical module";
            alert-type interfaces.optics.optical-power.rx-signal-power;
            term rx-betweeen-threshold {
                when {
                    greater-than "$rx-signal-power" "$rx-signal-power-low-threshold";
                    less-than "$rx-signal-power" "$rx-signal-power-high-threshold";
                }
                then {
                    status {
                        color green;
                        message "$interface-name,Rx Signal Power $rx-signal-power is normal";
                    }
                }
            }
            term rx-signal-power-above-high-threshold {
                when {
                    greater-than-or-equal-to "$rx-signal-power" "$rx-signal-power-high-threshold";
                }
                then {
                    status {
                        color red;
                        message "$interface-name,Rx Signal Power $rx-signal-power is above high threshold ($rx-signal-power-high-threshold)";
                    }
                }
            }
            term rx-signal-power-below-low-threshold {
                when {
                    less-than-or-equal-to "$rx-signal-power" "$rx-signal-power-low-threshold";
                }
                then {
                    status {
                        color red;
                        message "$interface-name,Rx Signal Power $rx-signal-power is below low threshold ($rx-signal-power-low-threshold)";
                    }
                }
            }
        }
        trigger osnr {
            synopsis "Optical Signal-to-Noise Ratio";
            description "Quality of an optical signal relative to the optical noise present on the fiber";
            alert-type interfaces.optics.signal-quality.osnr;
            term osnr-normal {
                when {
                    greater-than-or-equal-to "$osnr" "$osnr-low-threshold";
                }
                then {
                    status {
                        color green;
                        message "$interface-name,osnr $osnr is normal";
                    }
                }
            }
            term osnr-error {
                when {
                    less-than "$osnr" "$osnr-low-threshold";
                }
                then {
                    status {
                        color red;
                        message "$interface-name,osnr $osnr is below low threshold ($osnr-low-threshold) ";
                    }
                }
            }
        }
        trigger pre-fec-ber {
            synopsis "Pre-Forward Error Correction Bit Error Rate";
            description "It is the bit error rate measured before FEC is applied to the receiving signal";
            alert-type interfaces.optics.errors.pre-fec-ber;
            term pre-fec-ber-normal {
                when {
                    less-than "$pre-fec-ber" "$pre-fec-ber-high-threshold";
                }
                then {
                    status {
                        color green;
                        message "$interface-name,pre-fec-ber $pre-fec-ber is normal";
                    }
                }
            }
            term pre-fec-ber-error {
                when {
                    greater-than-or-equal-to "$pre-fec-ber" "$pre-fec-ber-high-threshold";
                }
                then {
                    status {
                        color red;
                        message "$interface-name,pre-fec-ber $pre-fec-ber is above high threshold ($pre-fec-ber-high-threshold) ";
                    }
                }
            }
        }
        variable carrier-frequency-offset-high-threshold {
            value 3600;
            description "Critical threshold of carrier-frequency-offset";
            type integer;
            value-type coherent-optics.cfo-max;			
        }
        variable carrier-frequency-offset-low-threshold {
            value -3600;
            description "Minor threshold value of carrier-frequency-offset";
            type integer;
            value-type coherent-optics.cfo-min;			
        }
        variable esnr-low-threshold {
            value 15;
            description "Minimum acceptable ESNR (dB). Below this value raises a critical alert";
            type float;
            value-type coherent-optics.esnr-min;			
        }
        variable interface-name {
            value "(?i)^(?:CHASSIS\\d+:)?FPC\\d+:PIC\\d+:(?:NPU\\d+:)?PORT\\d+:XCVR\\d+:OCH$";
            description "Name of the interface.";
            type string;
            value-type coherent-optics.interface;
        }
        variable rx-signal-power-high-threshold {
            value .*;
            description "Upper rx signal power limit (dBm). Power at or beyond this value raises a critical alert.";
            type integer;
            value-type coherent-optics.rx-signal-power-max;			
        }
        variable rx-signal-power-low-threshold {
            value .*;
            description "Lower rx signal power limit (dBm). Power at or beyond this value raises a minor alert";
            type integer;
            value-type coherent-optics.rx-signal-power-min;	 		
        }
        variable osnr-low-threshold {
            value 26;
            description "Minimum acceptable OSNR (dB). Below this value raises a critical alert";
            type float;
            value-type	coherent-optics.osnr-min;		
        }
        variable pre-fec-ber-high-threshold {
            value 0.009;
            description "Maximum acceptable pre-FEC BER. At or above this value raises a critical alert";
            type float;
            value-type coherent-optics.pre-fec-ber-max;			
        }
        variable q-factor-threshold {
            value 6;
            description "Minimum acceptable Q-factor (dB). Below this value raises a critical alert";
            type float;
        }
        variable q-margin-threshold {
            value 3;
            description "Minimum acceptable Q-margin (dB) before the FEC limit. Below this value raises a critical alert";
            type float;
        }
        variable fec-threshold-ber {
            value 6;
            description "fec ber threshold used in Q-Margin formula";
            type float;
            value-type coherent-optics.fec-threshold-ber;			
        }		
        rule-properties {
            domain-name interfaces;
            supported-devices {
                sensors optical-sensor-oc;
                juniper {
                    operating-system junos {
                        products JNP {
                            sensors optical-sensor-oc;
                            platforms JNP10004 {
                                releases 22.3R1 {
                                    release-support min-supported-release;
                                }
                            }
                            platforms JNP10008 {
                                releases 22.3R1 {
                                    release-support min-supported-release;
                                }
                            }
                            platforms JNP10016 {
                                releases 22.3R1 {
                                    release-support min-supported-release;
                                }
                            }
                        }
                        products MX {
                            sensors optical-sensor-oc;
                            platforms MX10004 {
                                releases 22.3R1 {
                                    release-support min-supported-release;
                                }
                            }
                            platforms MX10008 {
                                releases 22.3R1 {
                                    release-support min-supported-release;
                                }
                            }
                            platforms MX10016 {
                                releases 22.3R1 {
                                    release-support min-supported-release;
                                }
                            }
                            platforms MX204 {
                                releases 23.2R1 {
                                    release-support min-supported-release;
                                }
                            }
                            platforms MX304 {
                                releases 23.2R1 {
                                    release-support min-supported-release;
                                }
                            }
                        }
                    }
                    operating-system junosEvolved {
                        products ACX {
                            sensors optical-sensor-oc;
                            platforms ACX7024 {
                                releases 23.2R1 {
                                    release-support min-supported-release;
                                }
                            }
                            platforms ACX7100 {
                                releases 23.2R1 {
                                    release-support min-supported-release;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
}