/*
 * Collects RIB protocol statistics for plotting and ML
 */
 healthbot {
    topic routing.rib {
        rule collect-rib-table-protocol-routes {
            keys [ protocol-name table-name ];
            synopsis "Protocols routes statistics collector";
            description "Collects total-route-count of each protocol for plotting and ML";
            sensor route-protocol-summary {
                synopsis "Get routing table protocol statistics using iAgent sensor";
                description "Get routing table statistics through -show route summary- command and filters protocols in each routing table";
                iAgent {
                    file route-protocol-summary.yml;
                    table RouteProtocolsTable;
                    frequency 3m;
                }
            }
            field active-route-count {
                sensor route-protocol-summary {
                    path active-route-count;
                }
                type integer;
                description "Protocol active route count";
                plots protocol-routes-count {
                    unit count;
                    triggers protocol-routes-count;
                    thresholds route-count-threshold {
                        field-name "$threshold";
                        severity critical;
                    }
                    thresholds active-route-count-anomaly {
                        field-name "$active-route-count-anomaly";
                        severity minor;
                        type jaiml-threshold;
                    }
                }
            }
            field protocol-name {
                sensor route-protocol-summary {
                    where "protocol-name =~ /^{{route-protocol-name}}$/";
                    path protocol-name;
                }
                type string;
                description "Protocol to monitor";
            }
            field protocol-total-route-count {
                sensor route-protocol-summary {
                    path protocol-route-count;
                }
                type integer;
                description "Protocol route count";
            }
            field table-name {
                sensor route-protocol-summary {
                    where "table-name =~ /^{{route-table-name}}$/";
                    path table-name;
                }
                type string;
                description "Route-table to monitor";
            }
            field threshold {
                constant {
                    value "{{route-count-threshold}}";
                }
                type integer;
                description "Route count static threshold";
            }
            field active-route-count-anomaly {
                formula {
                    jaiml-anomaly-detection {
                        field-name "$active-route-count";
                    }
                }
                type integer;
                description "JAIML anomaly detection on active-route-count field";
            }
            trigger protocol-routes-count {
                alert-type routing.rib.protocol.routes.count.protocol-routes-count;
                frequency 1offset;
                /*
                 * Sets color to green when active-route-count is less than threshold
                 * and active-route-count value is normal.
                 */
                term protocol-route-count-normal {
                    when {
                        less-than "$active-route-count" "$threshold";
                        less-than-or-equal-to "$active-route-count-anomaly" 0;
                    }
                    then {
                        status {
                            color green;
                            message "Protocol $protocol-name of route-table ($table-name) active route count($active-route-count)is normal and total route count is ($protocol-total-route-count)";
                        }
                    }
                }
                /*
                 * Sets color to yellow when active-route-count is less than threshold
                 * and active-route-count value is anomalous.
                 */
                term protocol-route-count-anomalous {
                    when {
                        less-than "$active-route-count" "$threshold";
                        equal-to "$active-route-count-anomaly" 1;
                    }
                    then {
                        status {
                            color yellow;
                            message "Protocol $protocol-name of route-table ($table-name) active route count is anomalous";
                        }
                    }
                }
                term protocol-route-count-ok {
                    when {
                        less-than "$active-route-count" "$threshold";
                    }
                    then {
                        status {
                            color green;
                            message "Protocol $protocol-name of route-table ($table-name) active route count($active-route-count)is normal and total route count is ($protocol-total-route-count)";
                        }
                    }
                }
                term above-static-threshold {
                    when {
                        greater-than-or-equal-to "$active-route-count" "$threshold";
                    }
                    then {
                        status {
                            color red;
                            message "Protocol $protocol-name of route-table ($table-name) active route count($active-route-count) is abnormal and total route count is ($protocol-total-route-count)";
                        }
                    }
                }
            }
            variable route-count-threshold {
                value 10000;
                description "Route table's route-count threshold";
                type int;
            }
            variable route-protocol-name {
                value .+;
                description "Route table specific routes, regular expression, e.g. 'BGP|RSVP|IS-ISI'";
                type string;
            }
            variable route-table-name {
                value .+;
                description "Route table specific routes, regular expression, e.g. 'inet.0|inet6.0|vpn_1.inet6.0'";
                type string;
            }
            rule-properties {
                version 2;
                domain-name fib;
                contributor juniper;
                category advanced;
                is-scaling-rule {
                    description "Fields:table-name ; Directly impacted by number of routing tables running in each network device";
                }
                supported-healthbot-version 1.0.1;
                supported-devices {
                    juniper {
                        operating-system junos {
                            products ACX {
                                platforms All {
                                    releases 15.2R1 {
                                        release-support min-supported-release;
                                    }
                                }
                            }
                            products EX {
                                platforms EX4300-48MP {
                                    releases 22.4R2.8 {
                                        release-support min-supported-release;
                                    }
                                }
                            }
                            products MX {
                                platforms All {
                                    releases 11.4R1 {
                                        release-support min-supported-release;
                                    }
                                }
                            }
                            products PTX {
                                platforms All {
                                    releases 11.4R1 {
                                        release-support min-supported-release;
                                    }
                                }
                            }
                            products QFX {
                                platforms All {
                                    releases 15.2R1 {
                                        release-support min-supported-release;
                                    }
                                }
                            }
                            products SRX {
                                platforms All {
                                    releases 15.2R1 {
                                        release-support min-supported-release;
                                    }
                                }
                            }
                        }
                        operating-system junosEvolved {
                            products ACX {
                                platforms All {
                                    releases 22.3R1 {
                                        release-support min-supported-release;
                                    }
                                }
                            }
                            products PTX {
                                platforms PTX10008 {
                                    releases 22.2R3 {
                                        release-support min-supported-release;
                                    }
                                }
                            }
                        }
                    }
                }
                helper-files other {
                    list-of-files route-protocol-summary.yml;
                }
            }
        }
    }
}