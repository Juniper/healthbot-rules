/*
 *   This rule collects evpn neighbor count and notifies anomaly when neigbor 
 *   disappears.
 *
 * Requirement 455 - https://paragon-automation.atlassian.net/browse/REQ-455
 *
 */
 healthbot {
    topic evpn {
        description "Collects EVPN neighbor count periodically and notifies anomaly when a neighbor disappears";
        rule check-evpn-neighbor {
            keys evpn-instance-name;
            sensor evpnNeighbors {
                iAgent {
                    file EvpnInstanceInfo.yml;
                    table EvpnInstanceInfoTable;
                    frequency 180s;
                }
            }
            field evpn-instance-name {
                sensor evpnNeighbors {
                    where "evpn-instance-name =~ /{{instance-name}}/";
                    path evpn-instance-name;
                }
                type string;
                description "EVPN instance name";
            }
            field evpn-num-neighbors {
                sensor evpnNeighbors {
                    path evpn-num-neighbors;
                }
                type integer;
                description "Number of EVPN neighbors";
                plots evpn-neighbors {
                    unit count;
                    triggers evpn-neighbor-state;
                }				
            }
            variable instance-name {
                value .*;
                type string;
                description "evpn instance-name to be monitored in regex.";
            }
            trigger evpn-neighbor-state {                
                description "Evaluates EVPN neighbor count and raises anomaly when the neighbor count is zero.";                
                alert-type vpn.evpn.state.neighbor-state;			
                frequency 1offset;
                term is-evpn-neighbor-exists {
                    when {
                        greater-than "$evpn-num-neighbors" 0;
                    }
                    then {
                        status {
                            color green;
                            message "EVPN instance $evpn-instance-name neighbor state is up";
                        }
                    }
                }
                term evpn-instance-down {
                    then {
                        status {
                            color red;
                            message "EVPN instance $evpn-instance-name neighbor state is down";
                        }
                    }
                }
            }
            rule-properties {
                version 1;
                contributor juniper;
                supported-healthbot-version 4.0.0;
                supported-devices {
                    juniper {
                         operating-system junos {
                            products MX {
                                platforms All {
                                    releases 15.1R1 {
                                        release-support min-supported-release;
                                    }
                                }
                            }
                         }
                         operating-system junosEvolved {
                            products ACX {
                                platforms All {
                                    releases 22.1R1 {
                                        release-support min-supported-release;
                                    }
                                }
                            }
                        }						
                    }
                }
            }
        }
    }
}
